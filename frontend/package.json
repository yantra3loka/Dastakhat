{
  "name": "dastakhat-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dastakhat - self hosted mini e-signature platform (Vue 3 frontend)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
