# ---------------------------------------------------------------------------
# Dastakhat - development environment template.
# Copy to `.env` (git-ignored) and adjust. NEVER commit the real `.env`.
# All credentials below are DEVELOPMENT ONLY throwaway values.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dastakhat
DB_USER=dastakhat
DB_PASSWORD=change-me-local-dev

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8080
# Where uploaded / generated documents are written (outside any web root).
DASTAKHAT_STORAGE_DIR=./storage
# Comma separated list of allowed CORS origins for the SPA.
DASTAKHAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public base URL of the frontend, used to build signing links inside e-mails.
DASTAKHAT_PUBLIC_BASE_URL=http://localhost:5173
# Signing link default lifetime in days.
DASTAKHAT_DEFAULT_LINK_EXPIRY_DAYS=7
# Session idle timeout in minutes.
DASTAKHAT_SESSION_TIMEOUT_MINUTES=120
# Set to true only behind HTTPS.
DASTAKHAT_COOKIE_SECURE=false

# --- SMTP (Mailpit) --------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@dastakhat.local
MAIL_FROM_NAME=Dastakhat

# --- Mock eSign provider (Stage 3, MOCK ONLY) ------------------------------
MOCK_ESP_BASE_URL=http://localhost:9100
# Callback URL the MOCK ESP posts the signed response back to.
DASTAKHAT_ESIGN_CALLBACK_URL=http://localhost:8080/api/v1/esign/callback
# Fixed TEST OTP displayed by the mock. Never a real OTP.
MOCK_ESP_TEST_OTP=123456

# --- DSC signing agent (Stage 2) -------------------------------------------
DSC_AGENT_BASE_URL=https://127.0.0.1:51515
# Origin allowlist enforced by the local agent (comma separated).
DSC_AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Development PKI (TEST ONLY) -------------------------------------------
# Directory holding the generated TEST CA / seal / mock certificates.
DASTAKHAT_PKI_DIR=../devpki/out
DASTAKHAT_SEAL_KEYSTORE=../devpki/out/platform-seal.p12
DASTAKHAT_SEAL_KEYSTORE_PASSWORD=changeit
DASTAKHAT_SEAL_CERT=../devpki/out/platform-seal-cert.pem
DASTAKHAT_TRUST_ROOTS=../devpki/out/test-root-ca.pem

# --- Development seed sender ----------------------------------------------
# Seed user created on first start (development only).
DASTAKHAT_SEED_EMAIL=sender@example.test
DASTAKHAT_SEED_NAME=Dastakhat Sender
DASTAKHAT_SEED_PASSWORD=ChangeMe!123
